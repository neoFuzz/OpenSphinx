{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Server",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}\\server\\src\\index.ts",
            "outFiles": [
                "${workspaceFolder}/**/*.js"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Client",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}\\client\\src\\index.ts",
            "outFiles": [
                "${workspaceFolder}/**/*.js"
            ]
        },
        {
            "name": "Debug Server",
            "type": "node",
            "request": "launch",
            "preLaunchTask": "Run Server",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev",
                "--workspace",
                "server-worker"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "port": 9229
        },
        {
            "name": "Debug Client",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/client",
            "preLaunchTask": "Run Client",
            "breakOnLoad": true
        }
    ]
}