{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@laser/shared": ["../shared/src/index.ts"],
      "@laser/shared/types": ["../shared/src/types.ts"],
      "@laser/shared/engine": ["../shared/src/engine/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
